{
  "name": "giftpay-family",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:development": "eas build --platform android --profile development --clear-cache",
    "build:android:preview": "eas build --platform android --profile preview --clear-cache",
    "build:android:production": "eas build --platform android --profile production --clear-cache",
    "build:ios:development": "eas build --platform ios --profile development --clear-cache",
    "build:ios:preview": "eas build --platform ios --profile preview --clear-cache",
    "build:ios:production": "eas build --platform ios --profile production --clear-cache",
    "submit:android": "npx eas submit --platform android",
    "submit:ios": "npx eas submit --platform ios",
    "pull:env": "eas env:pull --environment",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchAll=false",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.14.0",
    "@bugsnag/expo": "^54.0.0",
    "@expo-google-fonts/outfit": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.0.5",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.61.3",
    "axios": "^1.7.8",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-checkbox": "~5.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "immer": "^10.1.1",
    "lucide-react-native": "^0.525.0",
    "onesignal-expo-plugin": "^2.7.0",
    "posthog-react-native": "^4.63.0",
    "react": "19.1.0",
    "react-hook-form": "^7.53.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-onesignal": "5.2.14",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "styled-components": "^6.1.13",
    "vanilla-masker": "^1.2.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "test-renderer": "^1.2.0"
  },
  "private": true
}
